# Shared secret required for the client to authenticate with the server.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
SERVER_WS_URL=wss://tunnel-agent.rajababu.duckdns.org:4343
LOCAL_APP_HOST=127.0.0.1
LOCAL_APP_PORT=8000
RECONNECT_DELAY=3
WS_PING_INTERVAL=20
READ_CHUNK_SIZE=65536

HTTP_LISTEN_HOST=127.0.0.1
HTTP_LISTEN_PORT=5000
WS_LISTEN_HOST=127.0.0.1
WS_LISTEN_PORT=9000
